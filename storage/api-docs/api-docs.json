    "components": {
        "schemas": {
            "Customer": {
                "title": "Customer",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "customer_code": {
                        "type": "string",
                        "example": "CUST-001"
                    },
                    "full_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "08123456789"
                    },
                    "company_name": {
                        "type": "string",
                        "example": "PT Example",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "example": "Lead"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
